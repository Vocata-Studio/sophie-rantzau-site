<section class="contact" id="kontakt">
  <div class="wrap">
    <span class="eyebrow contact-eyebrow">
      <span data-da>Kontakt</span>
      <span data-en>Contact</span>
    </span>

    <div class="contact-grid">

    <!-- Left col -->
    <div class="contact-left">
      <h2 class="display contact-headline" data-da>
        Lad os tage<br /><em>en samtale.</em>
      </h2>
      <h2 class="display contact-headline" data-en>
        Let's have<br /><em>a conversation.</em>
      </h2>

      <p class="contact-lede" data-da>
        Skriv et par linjer om, hvad du står med — så vender jeg tilbage hurtigst muligt.
      </p>
      <p class="contact-lede" data-en>
        Write a few lines about where you are right now — I'll get back to you as soon as I can.
      </p>

      <a href="https://cal.eu/sophie-rantzau/free-discovery-call" target="_blank" rel="noopener" class="btn btn-primary contact-cal">
        <span data-da>Book gratis intro-samtale</span>
        <span data-en>Book Free Discovery Call</span>
        <span class="arr">&rarr;</span>
      </a>

      <dl class="contact-details">
        <div class="contact-row">
          <dt data-da>Telefon</dt>
          <dt data-en>Phone</dt>
          <dd><a href="tel:+4530880828">+45 30 88 08 28</a></dd>
        </div>
        <div class="contact-row">
          <dt>Email</dt>
          <dd><a href="mailto:hej@sophierantzau.dk">hej@sophierantzau.dk</a></dd>
        </div>
        <div class="contact-row">
          <dt data-da>Adresse</dt>
          <dt data-en>Address</dt>
          <dd>
            <span data-da>Nykøbing Mors, Danmark</span>
            <span data-en>Nykøbing Mors, Denmark</span>
          </dd>
        </div>
        <div class="contact-row">
          <dt>Social</dt>
          <dd class="contact-social">
            <a href="#" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
              </svg>
            </a>
            <a href="#" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <!-- Right col: form -->
    <div class="contact-form-wrap">
      <form id="contact-form" class="contact-form" novalidate>
        <p style="position:absolute; left:-9999px;" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="contact-form-row contact-form-row--2col">
          <div class="contact-field">
            <label for="cf-navn" data-da>Navn</label>
            <label for="cf-navn" data-en>Name</label>
            <input id="cf-navn" type="text" name="navn" autocomplete="name" maxlength="200" required />
          </div>
          <div class="contact-field">
            <label for="cf-email">Email</label>
            <input id="cf-email" type="email" name="email" autocomplete="email" maxlength="200" required />
          </div>
        </div>

        <div class="contact-field">
          <label for="cf-telefon" data-da>Telefon <span class="field-opt">(valgfri)</span></label>
          <label for="cf-telefon" data-en>Phone <span class="field-opt">(optional)</span></label>
          <input id="cf-telefon" type="tel" name="telefon" autocomplete="tel" maxlength="50" />
        </div>

        <div class="contact-field">
          <label for="cf-besked" data-da>Besked</label>
          <label for="cf-besked" data-en>Message</label>
          <textarea id="cf-besked" name="besked" rows="5" maxlength="5000" required></textarea>
        </div>

        <p id="contact-status" class="contact-status" role="status" aria-live="polite" hidden></p>

        <button type="submit" id="contact-submit" class="btn btn-primary contact-submit">
          <span data-label-idle>
            <span data-da>Send besked</span>
            <span data-en>Send message</span>
            <span class="arr">&rarr;</span>
          </span>
          <span data-label-loading hidden>
            <span data-da>Sender…</span>
            <span data-en>Sending…</span>
          </span>
        </button>
      </form>
    </div>

    </div><!-- /.contact-grid -->
  </div><!-- /.wrap -->
</section>

<script>
  const messages = {
    da: {
      missing: 'Udfyld navn, email og besked.',
      email: 'Indtast en gyldig email-adresse.',
      length: 'Beskeden er for lang.',
      invalid: 'Ugyldig forespørgsel.',
      config: 'Beskeden kunne ikke sendes. Prøv igen senere.',
      send: 'Beskeden kunne ikke sendes. Prøv igen senere.',
      network: 'Kunne ikke kontakte serveren. Tjek din forbindelse og prøv igen.',
      success: 'Tak for din besked — jeg vender tilbage hurtigst muligt.',
    },
    en: {
      missing: 'Please fill in name, email and message.',
      email: 'Enter a valid email address.',
      length: 'The message is too long.',
      invalid: 'Invalid request.',
      config: 'The message could not be sent. Please try again later.',
      send: 'The message could not be sent. Please try again later.',
      network: 'Could not reach the server. Check your connection and try again.',
      success: "Thanks for your message — I'll get back to you as soon as I can.",
    },
  } as const;

  type MsgKey = keyof (typeof messages)['da'];

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLParagraphElement | null;
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && status && submit) {
    const idleLabel = submit.querySelector<HTMLElement>('[data-label-idle]');
    const loadingLabel = submit.querySelector<HTMLElement>('[data-label-loading]');

    const currentLang = () =>
      (document.body.dataset.lang === 'en' ? 'en' : 'da') as keyof typeof messages;

    const setStatus = (key: MsgKey | '', tone: 'success' | 'error') => {
      if (!key) {
        status.hidden = true;
        status.textContent = '';
        return;
      }
      status.textContent = messages[currentLang()][key];
      status.hidden = false;
      status.classList.toggle('contact-status--success', tone === 'success');
      status.classList.toggle('contact-status--error', tone === 'error');
    };

    const setLoading = (loading: boolean) => {
      submit.disabled = loading;
      idleLabel?.toggleAttribute('hidden', loading);
      loadingLabel?.toggleAttribute('hidden', !loading);
      form
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')
        .forEach((field) => {
          field.disabled = loading;
        });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('', 'success');

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: String(data.get('navn') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        phone: String(data.get('telefon') ?? '').trim(),
        message: String(data.get('besked') ?? '').trim(),
        botField: String(data.get('bot-field') ?? ''),
      };

      setLoading(true);
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: MsgKey;
        };

        if (res.ok && body.ok) {
          form.reset();
          setStatus('success', 'success');
        } else {
          setStatus(body.error ?? 'send', 'error');
        }
      } catch {
        setStatus('network', 'error');
      } finally {
        setLoading(false);
      }
    });
  }
</script>
