---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer-separator" aria-hidden="true">
    <img src="/brand/footer-separator.webp" alt="" width="3947" height="360" decoding="async" />
  </div>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo variant="stacked" />
        <p class="footer-tag" data-da>
          Personlig coaching for mennesker i bevægelse — fra Nykøbing Mors, tæt på Limfjorden.
        </p>
        <p class="footer-tag" data-en>
          Personal coaching for people in motion — from Nykøbing Mors, close to the Limfjord.
        </p>
      </div>
      <div>
        <h5><span data-da>Kontakt</span><span data-en>Contact</span></h5>
        <ul>
          <li><a href="mailto:hej@sophierantzau.dk">hej@sophierantzau.dk</a></li>
          <li><a href="tel:+4530880828">+45 30 88 08 28</a></li>
          <li><span data-da>Nykøbing Mors, Danmark</span><span data-en>Nykøbing Mors, Denmark</span></li>
        </ul>
      </div>
      <div>
        <h5><span data-da>Følg med</span><span data-en>Follow</span></h5>
        <ul class="footer-social">
          <li>
            <a href="https://www.facebook.com/profile.php?id=61587224121486" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Sophie Rantzau &middot; CVR 46254716</span>
      <span><a href="/privatlivspolitik"><span data-da>Persondatapolitik</span><span data-en>Privacy</span></a> &middot; <a href="/privatlivspolitik#cookies">Cookies</a></span>
    </div>
  </div>
  <a
    href="https://vocata.studio/"
    target="_blank"
    rel="noopener noreferrer"
    class="vocata-signature"
    aria-label="Designet & Udviklet af VocataWeb"
  >
    <span class="vocata-signature-inner">
      <img src="/vocata-signature.png" alt="VocataWeb" width="30" height="30" decoding="async" />
      <span>Designet &amp; Udviklet af VocataWeb</span>
    </span>
  </a>
</footer>
